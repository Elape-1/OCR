DATABASE_URL=postgresql+psycopg2://ocr_user:ocr_password@localhost:5432/ocr_system
AUTH_REQUIRED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=frontend-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-storage-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=ocr-documents
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
RAW_DATASET_PAGES_DIR=datasets/raw-pages
TESSERACT_CMD=tesseract
POPPLER_PATH=
SOFFICE_CMD=soffice
# The base LayoutLMv3 checkpoint is pretrained but has no trained extraction head.
LAYOUTLMV3_MODEL_SOURCE=microsoft/layoutlmv3-base
LAYOUTLMV3_OCR_ONLY=true
CELERY_TASK_ALWAYS_EAGER=false
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_REQUIRED=true
ENABLE_DEBUG_ENDPOINTS=false
DEBUG_UPLOAD_MAX_BYTES=10485760
